{
  "name": "rdx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "node scripts/start.mjs",
    "check": "tsc --noEmit",
    "test": ".venv/bin/python -m pytest -q",
    "render": "mkdir -p artifacts/renders && RENDER_DIR=$PWD/artifacts/renders playwright test --config=scripts/render/records.config.ts --reporter=line",
    "render:drop": "rm -rf artifacts/drop-data && mkdir -p artifacts/drop && RENDER_DIR=$PWD/artifacts/drop playwright test --config=scripts/render/drop.config.ts --reporter=line",
    "measure": ".venv/bin/python scripts/render/measure.py",
    "test:browser": "playwright test",
    "format": "prettier --write src bridge/connection.js scripts/*.mjs tests/browser playwright.config.ts vite.config.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  }
}
