.venv/
.cache/
node_modules/
dist/
__pycache__/
.pytest_cache/
*.pyc
*.tsbuildinfo
artifacts/
.DS_Store
.idea/
*.iml

# data/ is private by default: it holds the user's projects, recordings, chat
# history and the bridge token. Everything below is an explicit exception, so
# adding a file under data/ never publishes it by accident.
data/*
!data/models
data/models/*

# An earlier adapter, kept because it is 14 MB and lets the comparison be rerun.
# It is not the active one: rdx-v3 is, and at 176 MB it stays local — README.md
# carries the command and the measurement. The 4 GB base model also stays out;
# it is a pinned public download, restored by scripts/fetch_model.py.
!data/models/rdx-v2
data/models/rdx-v2/*
!data/models/rdx-v2/adapters.safetensors
!data/models/rdx-v2/adapter_config.json
!data/models/rdx-v2/training-record.json
!data/models/rdx-v2/superseded.json

# The active adapter's record and measurement, for provenance. Not its weights.
!data/models/rdx-v3
data/models/rdx-v3/*
!data/models/rdx-v3/approved.json
!data/models/rdx-v3/adapter_config.json
!data/models/rdx-v3/training-record.json
!data/models/rdx-v3/superseded.json

!data/models/rdx-v4
data/models/rdx-v4/*
!data/models/rdx-v4/approved.json
!data/models/rdx-v4/adapter_config.json
!data/models/rdx-v4/training-record.json

# The retired adapter's record, for provenance. Not its weights.
!data/models/rdx-v1
data/models/rdx-v1/*
!data/models/rdx-v1/superseded.json
!data/models/rdx-v1/training-record.json

# The instruction data and every measurement that justified activating a model.
!data/training
data/training/*
!data/training/*.jsonl
!data/training/dataset.json
!data/training/base-evaluation.json
!data/training/adapter-evaluation.json
!data/training/train.yaml
!data/training/train.log
